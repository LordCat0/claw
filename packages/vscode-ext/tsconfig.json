{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "strictNullChecks": false,
    "types": ["vscode", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
