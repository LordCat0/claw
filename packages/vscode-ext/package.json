{
  "name": "vscode-ext",
  "displayName": "Claw",
  "description": "Language support for Claw.",
  "icon": "icon.png",
  "version": "1.0.0",
  "publisher": "LordCat0",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LordCat0/claw.git",
    "directory": "packages/vscode-ext"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": ["Programming Languages"],
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "esbuild extension=src/extension.ts claw=../shared/assets/claw.svg --bundle --platform=node --target=node20 --external:vscode --loader:.svg=copy --out-extension:.js=.cjs --outdir=dist",
    "package": "npx @vscode/vsce package --no-dependencies --out dist/claw.vsix",
    "preview": "npm run package && code --install-extension dist/claw.vsix --force",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "configurationDefaults": {
      "[claw]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "claw",
        "scopes": {
          "type": ["entity.name.type.js"],
          "type.defaultLibrary": ["support.type.primitive.js"],
          "keyword": ["storage.type.js"]
        }
      }
    ],
    "languages": [
      {
        "id": "claw",
        "aliases": ["Claw"],
        "extensions": [".claw"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./dist/claw.svg",
          "dark": "./dist/claw.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "claw",
        "scopeName": "source.claw",
        "path": "./syntaxes/claw.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "~1.146.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
