{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@clerk/express": [
        "./src/clerk.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
