{
  "name": "cdn",
  "version": "1.0.0",
  "description": "Package registry and CDN for claw files",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "http-graceful-shutdown": "^4.0.0",
    "pg": "^8.23.1",
    "semver": "^7.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2"
  }
}
