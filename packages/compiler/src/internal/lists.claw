type Scalar = number | string | boolean;

var reserving: number;
var allocated: number;

function* allocateFrame(bucket: number, size: number): number {
  waitUntil(reserving == 0);
  reserving = 1;

  // A free frame's first slot points to the next free frame in its bucket.
  var head = lists.item("$frameFree", bucket);
  if (head > 0) {
    allocated = head;
    lists.replace("$frameFree", bucket, lists.item("$frames", head));
  } else {
    if (lists.length("$frames") + size > 199999) {
      fail("Function memory is full.");
    }
    allocated = lists.length("$frames") + 1;
    repeat (size + 1) {
      lists.add("$frames", "");
    }
  }

  reserving = 0;
  return allocated;
}

function* releaseFrame(frame: number, bucket: number): void {
  lists.replace("$frames", frame, lists.item("$frameFree", bucket));
  lists.replace("$frameFree", bucket, frame);
}

function* initialize(frameBuckets: number): void {
  reserving = 0;
  repeat (frameBuckets) {
    lists.add("$frameFree", 0);
  }
}

function* fail(message: string): never {
  print(message);
  project.stop();
}

function* integer(value: Scalar): number {
  if (value != math.calculate("floor", value)) {
    fail("Expected a finite integer.");
  }
  if (value > 200000 || value < -200000) {
    fail("List index or length exceeds the Scratch limit.");
  }
  return value - 0;
}

function* bound(inputIndex: Scalar, count: number): number {
  var index = integer(inputIndex);
  if (index < 0) {
    index += count;
  }
  if (index < 0) {
    return 0;
  }
  if (index > count) {
    return count;
  }
  return index;
}

// The compiler binds source and target to specific Scratch lists.
function* listHelpers(source: Scalar[], target: Scalar[]): void {
  function* listAt(input: Scalar): Scalar {
    var index = integer(input);
    if (index < 0) {
      index += lists.length(source);
    }
    // Scratch list positions start at 1.
    return lists.item(source, index + 1);
  }

  function* listSet(input: Scalar, value: Scalar): void {
    var index = integer(input);
    var count = lists.length(source);
    if (index < 0 || index > count) {
      fail("List assignment is out of bounds.");
    }
    if (index == count) {
      if (count == 200000) {
        fail("List length exceeds the Scratch limit.");
      }
      lists.add(source, value);
    } else {
      lists.replace(source, index + 1, value);
    }
  }

  function* listResize(input: Scalar): void {
    var count = integer(input);
    if (count < 0) {
      fail("List length cannot be negative.");
    }
    var length = lists.length(source);
    repeat (length - count) {
      lists.delete(source, "last");
    }
    repeat (count - length) {
      lists.add(source, "");
    }
  }

  function* listAppend(startInput: Scalar, endInput: Scalar): void {
    var index = bound(startInput, lists.length(source)) + 1;
    var end = bound(endInput, lists.length(source)) + 1;
    if (lists.length(target) + end - index > 200000) {
      fail("List length exceeds the Scratch limit.");
    }
    repeat (end - index) {
      lists.add(target, lists.item(source, index));
      index++;
    }
  }

  function* listDeleteCount(start: number, inputCount: Scalar): number {
    var count = integer(inputCount);
    var remaining = lists.length(source) - start;
    if (count > remaining) {
      return remaining;
    }
    return count;
  }

  function* listDelete(start: number, count: number): void {
    if (count <= 0) {
      return;
    }
    if (count == 1) {
      lists.delete(source, start + 1);
      return;
    }
    var index = start + 1;
    var length = lists.length(source);
    while (index + count <= length) {
      lists.replace(source, index, lists.item(source, index + count));
      index++;
    }
    repeat (count) {
      lists.delete(source, "last");
    }
  }

  function* listTake(start: number, count: number): void {
    var index = start + 1;
    repeat (count) {
      lists.add(target, lists.item(source, index));
      index++;
    }
  }

  function* listReverse(): void {
    var left = 1;
    var right = lists.length(source);
    while (left < right) {
      var value = lists.item(source, left);
      lists.replace(source, left, lists.item(source, right));
      lists.replace(source, right, value);
      left++;
      right--;
    }
  }

  function* listFill(value: Scalar, startInput: Scalar, endInput: Scalar): void {
    var index = bound(startInput, lists.length(source)) + 1;
    var end = bound(endInput, lists.length(source)) + 1;
    repeat (end - index) {
      lists.replace(source, index, value);
      index++;
    }
  }

  function* listIndexOf(value: Scalar, startInput: Scalar): number {
    var index = bound(startInput, lists.length(source)) + 1;
    var end = lists.length(source) + 1;
    while (index < end) {
      if (lists.item(source, index) == value) {
        return index - 1;
      }
      index++;
    }
    return -1;
  }

  function* listLastIndexOf(value: Scalar, startInput: Scalar): number {
    var index = integer(startInput);
    var count = lists.length(source);
    if (index < 0) {
      index += count;
    }
    if (index >= count) {
      index = count - 1;
    }
    while (index >= 0) {
      if (lists.item(source, index + 1) == value) {
        return index;
      }
      index--;
    }
    return -1;
  }

  function* listJoin(separator: Scalar): Scalar {
    var result = lists.item(source, 1);
    var index = 2;
    repeat (lists.length(source) - 1) {
      result = compiler.join(
        compiler.join(result, separator),
        lists.item(source, index)
      );
      index++;
    }
    return result;
  }

  function* listSort(): void {
    var length = lists.length(source);
    var width = 1;

    // Merge adjacent runs, doubling their width on each pass.
    while (width < length) {
      lists.clear(target);
      var start = 1;
      while (start <= length) {
        const var middle = start + width;
        var end = middle + width;
        if (end > length + 1) {
          end = length + 1;
        }
        var left = start;
        var right = middle;
        repeat (end - start) {
          if (
            right >= end ||
            left < middle && !(lists.item(source, right) < lists.item(source, left))
          ) {
            lists.add(target, lists.item(source, left));
            left++;
          } else {
            lists.add(target, lists.item(source, right));
            right++;
          }
        }
        start = end;
      }

      var index = 1;
      repeat (length) {
        lists.replace(source, index, lists.item(target, index));
        index++;
      }
      width *= 2;
    }
    lists.clear(target);
  }
}
