{
  "name": "compiler",
  "version": "1.0.0",
  "description": "A programming language that compiles to scratch projects",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('src/assets', 'dist/src/assets', { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LordCat0/claw.git",
    "directory": "packages/compiler"
  },
  "keywords": [
    "scratch",
    "sb3",
    "claw"
  ],
  "author": "LordCat0",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LordCat0/claw/issues"
  },
  "homepage": "https://github.com/LordCat0/claw#readme",
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
